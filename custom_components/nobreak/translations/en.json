  "issues": {
    "substituir_bateria": {
      "title": "UPS: replace the battery",
      "description": "The UPS reports that its battery must be replaced (RB flag)."
    },
    "autoteste_reprovado": {
      "title": "UPS: self-test failed",
      "description": "The last self-test result was: {resultado}. Check the battery."
    },
    "bateria_antiga": {
      "title": "UPS: battery is {anos} years old",
      "description": "The battery was installed on {data}. Sealed lead-acid batteries last 3–5 years; run a deep self-test and plan the replacement."
    },
    "saude_baixa": {
      "title": "UPS: battery health {saude}%",
      "description": "The last discharge drained the battery much faster than the UPS predicted (health {saude}%). The real runtime is shorter than shown on the UPS."
    }
  },
  "services": {
    "comando": {
      "name": "Run command",
      "description": "Run an allow-listed UPS command (commands that cut the outlets are not available).",
      "fields": {
        "config_entry_id": {
          "name": "UPS",
          "description": "Needed only with more than one UPS."
        },
        "comando": {
          "name": "Command",
          "description": "NUT instant command."
        }
      }
    },
    "definir_variavel": {
      "name": "Set variable",
      "description": "Set a writable upsd variable (driver.* excluded).",
      "fields": {
        "config_entry_id": {
          "name": "UPS",
          "description": "Needed only with more than one UPS."
        },
        "variavel": {
          "name": "Variable",
          "description": "For example input.sensitivity."
        },
        "valor": {
          "name": "Value",
          "description": "New value."
        }
      }
    }
  },
  "exceptions": {
    "escolha_o_nobreak": {
      "message": "Choose the UPS (config_entry_id): none or more than one is loaded."
    },
    "comando_indisponivel": {
      "message": "This UPS does not support {comando}."
    },
    "variavel_nao_gravavel": {
      "message": "{variavel} is not writable. Writable: {gravaveis}."
    }
  }
