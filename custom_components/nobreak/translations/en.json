          "host": "Host",
          "port": "Port",
          "username": "Username",
          "password": "Password",
          "ups": "UPS name"
        },
        "data_description": {
          "ups": "Leave empty when upsd serves a single UPS."
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot reach upsd.",
      "ups_not_found": "This UPS is not served by upsd."
    },
